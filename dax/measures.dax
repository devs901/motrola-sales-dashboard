-- Create a dedicated _Measures table, then add these one by one using
-- Modeling > New measure in Power BI Desktop.

Revenue =
SUMX ( fact_sales, fact_sales[units] * fact_sales[unit_price] )

Gross Sales =
SUMX ( fact_sales, fact_sales[units] * fact_sales[mrp] )

Total Cost =
SUMX ( fact_sales, fact_sales[units] * fact_sales[unit_cost] )

Gross Profit =
[Revenue] - [Total Cost]

Gross Margin % =
DIVIDE ( [Gross Profit], [Revenue] )

Units Sold =
SUM ( fact_sales[units] )

Order Lines =
DISTINCTCOUNT ( fact_sales[order_line_id] )

Average Selling Price =
DIVIDE ( [Revenue], [Units Sold] )

Average Discount % =
1 - DIVIDE ( [Revenue], [Gross Sales] )

Returned Lines =
CALCULATE (
    DISTINCTCOUNT ( fact_sales[order_line_id] ),
    fact_sales[returned] = 1
)

Return Rate % =
DIVIDE ( [Returned Lines], [Order Lines] )

Average Customer Rating =
AVERAGE ( fact_sales[customer_rating] )

Revenue PY =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Revenue YoY Change =
[Revenue] - [Revenue PY]

Revenue YoY % =
DIVIDE ( [Revenue YoY Change], [Revenue PY] )

Revenue YTD =
TOTALYTD ( [Revenue], dim_date[date] )

Revenue Share % =
DIVIDE (
    [Revenue],
    CALCULATE ( [Revenue], REMOVEFILTERS ( dim_product ), REMOVEFILTERS ( dim_region ), REMOVEFILTERS ( dim_channel ) )
)

Model Revenue Rank =
RANKX ( ALL ( dim_product[model] ), [Revenue], , DESC, DENSE )

Units Returned =
CALCULATE ( [Units Sold], fact_sales[returned] = 1 )

Discount Amount =
[Gross Sales] - [Revenue]
